rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isEmployee() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }
    function isOwner(uid) { return request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(uid);
    }

    match /borrowers/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /loans/{id} {
      allow read: if isAuth() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /collateral/{id} {
      allow read: if isAuth() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /savings/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /savingsTargets/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }
  }
}
